---
import Button from "./Button.astro";
import { siteConfig } from "../config";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/** Analysis, delivery, enablement: the three steps the hero promises. */
const steps = [
  {
    number: "01",
    phase: "hero.step1Phase",
    title: "hero.step1Title",
    text: "hero.step1Text",
  },
  {
    number: "02",
    phase: "hero.step2Phase",
    title: "hero.step2Title",
    text: "hero.step2Text",
  },
  {
    number: "03",
    phase: "hero.step3Phase",
    title: "hero.step3Title",
    text: "hero.step3Text",
  },
] as const;
---

<div class="band">
  <div class="hero">
    <div class="columns">
      <div class="pitch">
        <div class="meta-row">
          <span class="identity">{t("hero.identity")}</span>
          {
            siteConfig.available && (
              <span class="avail">{t("hero.availability")}</span>
            )
          }
        </div>

        <h1 class="headline">{t("hero.headline")}</h1>

        <p class="tagline">{t("hero.tagline")}</p>

        <p class="intro">{t("hero.intro")}</p>

        <div class="buttons">
          <Button
            href={siteConfig.links.linkedin}
            label={t("hero.ctaPrimary")}
            variant="primary"
            external
          />
          <Button
            label={t("hero.ctaSecondary")}
            variant="secondary"
            data-cv-open
          />
        </div>
      </div>

      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step-item">
              <div class="phase">{t(step.phase)}</div>
              <div class:list={["step", { accent: index === 1 }]}>
                <span class="step-number">{step.number}</span>
                <div class="step-body">
                  <div class="step-title">{t(step.title)}</div>
                  <p class="step-text">{t(step.text)}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</div>

<style>
  .band {
    position: relative;
    isolation: isolate;
  }

  .band::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(
      var(--border-btn) 1.2px,
      transparent 1.2px
    );
    background-size: 36px 36px;
    mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
    pointer-events: none;
  }

  .hero {
    max-width: var(--maxw);
    margin: 0 auto;
    min-height: calc(min(100vh, 720px) - var(--header-h));
    min-height: calc(min(100svh, 720px) - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px var(--pad-x);
    border-bottom: 1px solid var(--border);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 30px;
    flex-wrap: wrap;
  }

  .identity {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--acc);
  }

  .avail {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--acc);
    border: 1px solid var(--acc-dim);
    background: var(--acc-dim);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  /* No gap: the phase rows carry the spacing so their timeline segment can
     bridge the full distance between two boxes. */
  .steps {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phase label with a timeline segment, aligned to the step numbers. */
  .phase {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0 14px 20px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-ghost);
  }

  .phase::before {
    content: "";
    align-self: stretch;
    flex: none;
    width: 2px;
    border-radius: 2px;
    background: var(--acc);
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    padding: 16px 20px;
    /* Opaque so the dot pattern of the hero band does not show through. */
    background: var(--surface);
    border: 1px solid var(--border-card);
    border-radius: 12px;
  }

  /* The middle step carries the actual differentiator: it is built, not advised. */
  .step.accent {
    background: linear-gradient(var(--acc-dim), var(--acc-dim)) var(--surface);
    border-color: var(--acc);
  }

  .step-number {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--acc);
  }

  .step-title {
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
  }

  .step-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .headline {
    margin: 0 0 28px;
    font-family: var(--font-mono);
    /* Scales down with the viewport so it still breaks into two lines
       once the hero splits into two columns. */
    font-size: clamp(40px, 3.6vw, 54px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin: 0 0 20px;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 500;
    color: var(--text-soft);
  }

  .intro {
    margin: 0 0 40px;
    max-width: 680px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .buttons {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  /* Gewollte Einrückung gegenüber den Sektionen, nur im Tablet-Band */
  @media (min-width: 769px) and (max-width: 1200px) {
    .hero {
      --pad-x: 64px;
    }
  }

  @media (max-width: 1080px) {
    .columns {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  @media (max-width: 768px) {
    .headline {
      font-size: 42px;
    }

    .buttons {
      flex-wrap: wrap;
    }
  }
</style>
