---
interface Props {
  number: string;
  title: string;
  description: string;
  meta: string;
  /** Trailing column: release status for projects, period for work entries. */
  note: string;
  /** Omit for entries without a public link; the row then renders as plain. */
  url?: string;
}

const { number, title, description, meta, note, url } = Astro.props;
const Tag = url ? "a" : "div";
const linkProps = url
  ? { href: url, target: "_blank", rel: "noopener" }
  : undefined;
---

<Tag class="row" {...linkProps}>
  <span class="number">{number}</span>
  <div class="body">
    <div class="title">{title}</div>
    <div class="description">{description}</div>
  </div>
  <span class="meta">{meta}</span>
  <span class="note">{note}</span>
</Tag>

<style>
  .row {
    display: grid;
    grid-template-columns: 64px 1fr 260px 150px;
    gap: 0 24px;
    align-items: baseline;
    padding: 20px 8px;
    border-top: 1px solid var(--border);
    transition: border-color 150ms ease;
  }

  .row:last-child {
    border-bottom: 1px solid var(--border);
  }

  a.row:hover {
    border-color: var(--acc);
    opacity: 1;
  }

  .number {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-ghost);
  }

  .title {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .description {
    max-width: 560px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .meta,
  .note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-faint);
  }

  .note {
    text-align: right;
  }

  @media (max-width: 768px) {
    .row {
      grid-template-columns: auto auto 1fr;
      grid-template-areas:
        "body body body"
        "number meta note";
      gap: 10px 14px;
    }

    .number {
      grid-area: number;
    }

    .body {
      grid-area: body;
    }

    .meta {
      grid-area: meta;
    }

    .note {
      grid-area: note;
    }
  }
</style>
