---
import StatPair from "./StatPair.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
  number: string;
  title: string;
  /** Omit for entries that describe responsibility rather than a fix. The
   *  labels are then dropped entirely, so no lone "solution" is left. */
  problem?: string;
  solution: string;
  /** Omit for entries without verifiable figures. */
  stats?: { value: string; label: string }[];
  meta: string;
  /** Trailing column: release status for projects, period for work entries. */
  note: string;
  /** Omit for entries without a public link; the row then renders as plain. */
  url?: string;
}

const { lang, number, title, problem, solution, stats, meta, note, url } =
  Astro.props;
const t = useTranslations(lang);
const Tag = url ? "a" : "div";
const linkProps = url
  ? { href: url, target: "_blank", rel: "noopener" }
  : undefined;
---

<Tag class="row" {...linkProps}>
  <span class="number">{number}</span>
  <div class="body">
    <div class="title">{title}</div>
    {
      problem && (
        <p class="line">
          <span class="label">{t("listing.problem")}</span>
          {problem}
        </p>
      )
    }
    <p class="line">
      {problem && <span class="label">{t("listing.solution")}</span>}
      {solution}
    </p>
    {
      stats && (
        <div class="stats">
          {stats.map((stat) => (
            <StatPair value={stat.value} label={stat.label} />
          ))}
        </div>
      )
    }
  </div>
  <span class="meta">{meta}</span>
  <span class="note">{note}</span>
</Tag>

<style>
  .row {
    display: grid;
    grid-template-columns: 64px 1fr 240px 130px;
    gap: 0 24px;
    align-items: baseline;
    padding: 20px 8px;
    border-top: 1px solid var(--border);
    transition: border-color 150ms ease;
  }

  .row:last-child {
    border-bottom: 1px solid var(--border);
  }

  a.row:hover {
    border-color: var(--acc);
    opacity: 1;
  }

  .number {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-ghost);
  }

  .title {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .line {
    margin: 0 0 4px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .line:last-child {
    margin-bottom: 0;
  }

  /* Scaled down against the featured cards, so the figures stay subordinate
     to the row title. */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 10px;
    --stat-value-size: 15px;
    --stat-label-size: 13px;
  }

  /* Labelled so the structure is visible at a glance and gives a reason
     to start reading. */
  .label {
    margin-right: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--acc);
  }

  .meta,
  .note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-faint);
  }

  /* Centred so it does not collide with the right-aligned note column. */
  .meta {
    text-align: center;
  }

  .note {
    text-align: right;
  }

  @media (max-width: 768px) {
    .row {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "body body"
        "meta note";
      gap: 10px 14px;
    }

    /* Hidden rather than moved: below the entry it would number nothing that
       is still ahead of the reader. */
    .number {
      display: none;
    }

    .body {
      grid-area: body;
    }

    .meta {
      grid-area: meta;
    }

    .note {
      grid-area: note;
    }
  }
</style>
