---
import { Image } from "astro:assets";
import Pill from "./Pill.astro";
import StatPair from "./StatPair.astro";
import type { FeaturedProject } from "../data/projects";
import type { Lang } from "../i18n/utils";

interface Props {
  project: FeaturedProject;
  lang: Lang;
}

const { project, lang } = Astro.props;
---

<a href={project.url} target="_blank" rel="noopener" class="card">
  <div class="head">
    <span class="number">{project.number}</span>
    <span class="title">{project.title}</span>
    <Pill label={project.status.label[lang]} variant={project.status.variant} />
  </div>

  <div class="body">
    {
      project.image &&
        ("src" in project.image ? (
          <div class="media">
            <Image
              src={project.image.src}
              alt={project.image.alt[lang]}
              widths={[580, 800]}
              sizes="(max-width: 768px) 100vw, 290px"
            />
          </div>
        ) : (
          <div class="placeholder">
            <span class="caption">{project.image.placeholder[lang]}</span>
          </div>
        ))
    }
    <div class="details">
      <p class="description">
        {project.lead && <span class="lead">{project.lead[lang]}</span>}{" "}
        {project.description[lang]}
      </p>

      {
        project.highlights && (
          <ul class="highlights">
            {project.highlights.map((highlight) => (
              <li>{highlight[lang]}</li>
            ))}
          </ul>
        )
      }

      {
        project.stats && (
          <div class="stats">
            {project.stats.map((stat) => (
              <StatPair value={stat.value} label={stat.label[lang]} />
            ))}
          </div>
        )
      }

      <span class="tags">{project.tags}</span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-card);
    transition: border-color 150ms ease;
  }

  .card:hover {
    border-color: var(--acc);
    opacity: 1;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Continues the numbering of the rows below, so both render one sequence. */
  .number {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-ghost);
  }

  .title {
    margin-right: auto;
    font-family: var(--font-mono);
    font-size: 26px;
    font-weight: 600;
  }

  /* Banner beside the text rather than above it. The fixed column keeps the
     image from scaling with the full-width card. */
  .body {
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 24px;
    align-items: start;
  }

  /* Description, stats and tags share the column next to the banner, so the
     text side reaches roughly the banner height instead of leaving a gap. */
  .details {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .description {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* Only the colour differs from the running text, so the sentence still
     reads as one and the eye still gets an entry point. */
  .lead {
    color: var(--acc);
  }

  /* The banners differ in ratio (1.90:1 vs 1.78:1). Until they are exported
     to a common size, `contain` plus a filler keeps both cards identical
     instead of cropping the wider one. */
  .media {
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    border: 1px solid var(--border-card);
    background: var(--bg);
    overflow: hidden;
  }

  .media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .placeholder {
    flex: 1;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid var(--border-card);
    background: repeating-linear-gradient(
      45deg,
      var(--placeholder-a) 0 14px,
      var(--placeholder-b) 14px 28px
    );
  }

  .caption {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--placeholder-caption);
  }

  .highlights {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 2;
    color: var(--text-muted);
  }

  .highlights li::before {
    content: "› ";
    color: var(--text-ghost);
  }

  /* Sits closer to the tags than to the description, so both meta lines read
     as one block below the text. */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: 8px;
  }

  .tags {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
  }

  @media (max-width: 768px) {
    /* Hidden like the row numbers, so no group carries numbers on mobile. */
    .number {
      display: none;
    }

    .body {
      grid-template-columns: 1fr;
    }

    .stats {
      gap: 10px 20px;
    }
  }
</style>
