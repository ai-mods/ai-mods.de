---
import { Image } from "astro:assets";
import portrait from "../assets/chris-portrait.webp";
import { siteConfig } from "../config";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * The CV sheet is German only for now. Once an English version exists, branch
 * on `lang` here and render the translated stations instead.
 *
 * Postal address, phone number and date of birth are deliberately omitted: this
 * page is public and crawlable, so only publishable data belongs in the sheet.
 */
---

<dialog id="cv-dialog" aria-labelledby="cv-name">
  <div class="bar">
    <button type="button" class="action" data-cv-print>{t("cv.print")}</button>
    <button type="button" class="action" data-cv-close>{t("cv.close")}</button>
  </div>

  <div class="viewport">
    <div class="page">
      <aside class="sidebar">
        <div class="photo-wrap">
          <Image src={portrait} alt="Christian Perkuhn" width={220} />
        </div>

        <div class="name-block">
          <p class="name" id="cv-name">Christian Perkuhn</p>
          <p class="name-tagline">Lösungen, die im Alltag ankommen.</p>
          <div class="contact">
            <div>Würzburg</div>
            <div>
              <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> ·
              <a class="web" href="https://ai-mods.de">ai-mods.de</a>
            </div>
          </div>
        </div>

        <section>
          <h3>Charakter</h3>
          <div class="pills">
            <span class="pill">Proaktiv</span>
            <span class="pill">Adaptiv</span>
            <span class="pill">Kreativ</span>
            <span class="pill">Team-Orientiert</span>
            <span class="pill">Analytisch</span>
          </div>
        </section>

        <section>
          <h3>Kernkompetenzen</h3>
          <div class="skill-row">
            <span class="skill-label">AI Strategy &amp; Practice</span>
            <span class="tag adv">seit 2023</span>
          </div>
          <div class="skill-row">
            <span class="skill-label">AI Frameworks &amp; Agents</span>
            <span class="tag adv">seit 2024</span>
          </div>
          <div class="skill-row">
            <span class="skill-label">Leadership &amp; Training</span>
            <span class="tag adv">seit 2008</span>
          </div>
          <div class="skill-row">
            <span class="skill-label">Enablement &amp; Adoption</span>
            <span class="tag adv">seit 2008</span>
          </div>
          <div class="skill-row">
            <span class="skill-label">Workflows &amp; Automation</span>
            <span class="tag adv">seit 2020</span>
          </div>
          <div class="skill-row">
            <span class="skill-label">Concept &amp; Delivery</span>
            <span class="tag adv">seit 2008</span>
          </div>
          <div class="skill-row">
            <span class="skill-label">Prototyping &amp; Apps</span>
            <span class="tag adv">seit 2023</span>
          </div>
        </section>

        <section>
          <h3>Werkzeuge</h3>
