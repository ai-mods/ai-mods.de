<style is:global>
  :root {
    --cv-dark: hsl(220 16% 14%);
    --cv-paper: #fff;
    --cv-accent: oklch(0.8 0.16 235);
    --cv-accent-ink: oklch(0.6 0.16 235);
    --cv-ink: #1a1a1a;
    --cv-ink-muted: #555;
    --cv-on-dark: rgb(255 255 255 / 90%);
    --cv-dot-off: #4a4a4a;
  }

  /* Print the CV sheet alone: hide the page behind it and drop the toolbar. */
  @media print {
    body.cv-open {
      background: #fff;
    }

    body.cv-open > *:not(#cv-dialog) {
      display: none !important;
    }

    body.cv-open #cv-dialog {
      position: static;
      display: block;
      width: 100%;
      max-width: none;
      max-height: none;
      border: 0;
      border-radius: 0;
      overflow: visible;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body.cv-open #cv-dialog .bar {
      display: none;
    }

    body.cv-open #cv-dialog .viewport {
      max-height: none;
      overflow: visible;
      padding: 0;
      background: #fff;
    }

    body.cv-open #cv-dialog .page {
      zoom: 1;
      box-shadow: none;
      margin: 0;
    }

    @page {
      size: A4;
      margin: 0;
    }
  }
</style>
