<script>
  const dialog = document.getElementById("cv-dialog") as HTMLDialogElement;
  const viewport = dialog.querySelector<HTMLElement>(".viewport");

  /** A4 width (210mm) in CSS pixels at 96dpi. */
  const SHEET_WIDTH = 794;

  const fit = () => {
    if (!viewport) return;
    const available = viewport.clientWidth - 32;
    const scale = Math.min(1, available / SHEET_WIDTH);
    viewport.style.setProperty("--cv-scale", String(scale));
  };

  const open = () => {
    dialog.showModal();
    document.body.classList.add("cv-open");
    fit();
  };

  document
    .querySelectorAll("[data-cv-open]")
    .forEach((el) => el.addEventListener("click", open));

  dialog
    .querySelector("[data-cv-close]")
    ?.addEventListener("click", () => dialog.close());

  dialog
    .querySelector("[data-cv-print]")
    ?.addEventListener("click", () => window.print());

  // A click lands on the dialog element itself only when it hits the backdrop.
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  // Covers the close button, the backdrop and the Escape key in one place.
  dialog.addEventListener("close", () => {
    document.body.classList.remove("cv-open");
  });

  window.addEventListener("resize", () => {
    if (dialog.open) fit();
  });
</script>

<style>
  #cv-dialog {
    width: min(880px, 96vw);
    max-height: 92vh;
    margin: auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
  }

  #cv-dialog::backdrop {
    background: rgb(0 0 0 / 70%);
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .action {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-soft);
    background: none;
    border: 1px solid var(--border-btn);
    border-radius: var(--radius-btn);
    padding: 9px 18px;
    cursor: pointer;
  }

  .action:hover {
    color: var(--acc);
    border-color: var(--acc);
  }

  .viewport {
    max-height: calc(92vh - 62px);
    overflow-y: auto;
    padding: 16px;
    background: #e9e9e9;
  }

  /* The sheet keeps its A4 proportions; zoom scales it into narrow viewports
     while still reserving the correct layout space. */
  .page {
    zoom: var(--cv-scale, 1);
    width: 210mm;
    height: 297mm;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    background: linear-gradient(
      to right,
      var(--cv-dark) 0 72mm,
      var(--cv-paper) 72mm 100%
    );
    box-shadow: 0 0 8mm rgb(0 0 0 / 15%);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 9.5pt;
    line-height: 1.45;
    color: var(--cv-ink);
  }

  .sidebar {
    width: 80mm;
    flex-shrink: 0;
    background: var(--cv-dark);
    color: var(--cv-on-dark);
    padding: 8mm;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .photo-wrap {
    width: 42mm;
    height: 42mm;
    margin: 0 auto;
    border-radius: 50%;
    border: 1.5mm solid var(--cv-accent);
    overflow: hidden;
    background: #333;
  }

  .photo-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .name-block {
    text-align: center;
  }

  .name {
    font-size: 15pt;
    font-weight: 700;
    margin: 0 0 1mm;
    line-height: 1.1;
  }

  .name-tagline {
    font-size: 8.5pt;
    font-weight: 400;
    color: var(--cv-accent);
    margin: 0;
    line-height: 1.2;
  }

  .contact {
    position: relative;
    text-align: center;
    font-size: 8pt;
    line-height: 1.5;
    margin-top: 2mm;
    padding-top: 2mm;
  }

  .contact::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 30mm;
    height: 0.5pt;
    background: rgb(255 255 255 / 25%);
  }

  .contact a {
    color: inherit;
    text-decoration: none;
  }

  .contact .web {
    color: var(--cv-accent);
  }

  .sidebar h3 {
    font-size: 11pt;
    font-weight: 700;
    margin: 0 0 1.5mm;
    letter-spacing: 0.5pt;
    text-transform: uppercase;
    text-align: center;
    color: rgb(255 255 255 / 60%);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5mm;
    justify-content: center;
    padding-bottom: 1mm;
  }

  .pill {
    display: inline-block;
    padding: 1.2mm 2.8mm;
    border: 0.5pt solid var(--cv-accent);
    border-radius: 8pt;
    font-size: 8.5pt;
    line-height: 1;
    white-space: nowrap;
