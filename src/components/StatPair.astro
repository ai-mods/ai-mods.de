---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="stat">
  <span class="value">{value}</span>
  <span class="label">{label}</span>
</div>

<style>
  .stat {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-mono);
  }

  /* Sizes are variables so a consumer can scale the pair down without a prop.
     Custom properties inherit past the scoped styles. */
  .value {
    font-size: var(--stat-value-size, 18px);
    font-weight: 600;
    color: var(--acc);
    letter-spacing: -0.02em;
  }

  .label {
    font-size: var(--stat-label-size, 15px);
    color: var(--text-muted);
  }
</style>
