---
import SiteHeader from "./SiteHeader.astro";
import Hero from "./Hero.astro";
import SectionShell from "./SectionShell.astro";
import FeaturedCard from "./FeaturedCard.astro";
import ListingRow from "./ListingRow.astro";
import SkillCard from "./SkillCard.astro";
import ServiceCard from "./ServiceCard.astro";
import AboutSection from "./AboutSection.astro";
import ContactSection from "./ContactSection.astro";
import CvModal from "./CvModal.astro";
import ToTopButton from "./ToTopButton.astro";
import SiteFooter from "./SiteFooter.astro";
import { featured, listed } from "../data/projects";
import { shaped, built } from "../data/work";
import { skills } from "../data/skills";
import { services } from "../data/services";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<SiteHeader lang={lang} />

<main>
  <Hero lang={lang} />

  <SectionShell id="profil" kicker={t("skills.kicker")}>
    <h2 class="heading">{t("skills.heading")}</h2>
    <p class="subheading">{t("skills.subheading")}</p>
    <p class="intro">{t("skills.intro")}</p>
    <div class="card-grid skills-grid">
      {skills.map((skill) => <SkillCard skill={skill} lang={lang} />)}
    </div>
  </SectionShell>

  <SectionShell id="projekte" kicker={t("projects.kicker")}>
    <h2 class="heading">{t("projects.heading")}</h2>
    <p class="subheading">{t("projects.subheading")}</p>
    <p class="intro">{t("projects.intro")}</p>

    <h3 class="group">{t("projects.groupShaped")}</h3>
    <div class="listings">
      {
        shaped.map((item) => (
          <ListingRow
            lang={lang}
            number={item.number}
            title={item.title[lang]}
            problem={item.problem?.[lang]}
            solution={item.solution[lang]}
            meta={item.meta}
            note={item.period[lang]}
          />
        ))
      }
    </div>

    <h3 class="group">{t("projects.groupBuilt")}</h3>
    <div class="listings">
      {
        built.map((item) => (
          <ListingRow
            lang={lang}
            number={item.number}
            title={item.title[lang]}
            problem={item.problem?.[lang]}
            solution={item.solution[lang]}
            meta={item.meta}
            note={item.period[lang]}
          />
        ))
      }
    </div>

    <h3 class="group">{t("projects.groupOwn")}</h3>
    <div class="featured-grid">
      {
        featured.map((project) => (
          <FeaturedCard project={project} lang={lang} />
        ))
      }
    </div>
    <div class="listings">
      {
        listed.map((project) => (
          <ListingRow
            lang={lang}
            number={project.number}
            title={project.title}
            problem={project.problem[lang]}
            solution={project.solution[lang]}
            meta={project.meta}
            note={project.status}
            url={project.url}
          />
        ))
      }
    </div>
  </SectionShell>

  <SectionShell id="services" kicker={t("services.kicker")}>
    <h2 class="heading">{t("services.heading")}</h2>
    <p class="subheading">{t("services.subheading")}</p>
    <p class="intro">{t("services.intro")}</p>
    <div class="card-grid" style={`--cols: ${services.length}`}>
      {services.map((service) => <ServiceCard service={service} lang={lang} />)}
    </div>
  </SectionShell>

  <AboutSection lang={lang} />
  <ContactSection lang={lang} />
  <ToTopButton lang={lang} />
</main>

<SiteFooter lang={lang} />

<CvModal lang={lang} />

<style>
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  /* Spaltenzahl folgt der Kartenanzahl, damit keine leere Spalte entsteht */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: 24px;
  }

  .skills-grid {
    grid-template-columns: 1fr 1fr 1fr 1fr;
  }

  .heading {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Group heading inside a section, one level below .heading. */
  .group {
    margin: 56px 0 18px;
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .group:first-of-type {
    margin-top: 0;
  }

  .subheading {
    margin: 0 0 28px;
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 500;
    color: var(--text-dim);
  }

  .intro {
    margin: 0 0 48px;
    max-width: 900px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  @media (max-width: 1080px) {
    .skills-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .featured-grid,
    .card-grid {
      grid-template-columns: 1fr;
    }

    .skills-grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .heading {
      font-size: 32px;
    }

    .subheading {
      font-size: 17px;
    }

    .group {
      margin-top: 44px;
      font-size: 20px;
    }
  }

  @media (max-width: 560px) {
    .skills-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
